{
  "name": "@taply/shared",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "test-vectors"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test-types.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": { "typescript": "7.0.2" }
}
