# INACTIVE LOCAL DRAFT. Publishing and dispatch require explicit authorization.
# Copy to .github/workflows only after review. No existing workflow is modified.
name: UNAPPROVED G1 reproducibility diagnostic
on:
  workflow_dispatch:
    inputs:
      expected_image_version:
        description: Exact reviewed Ubuntu image version; job fails on mismatch
        required: true
        type: string
permissions:
  contents: read
jobs:
  compare:
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    env:
      EXPECTED_IMAGE_VERSION: ${{ inputs.expected_image_version }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          path: harness
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: '24.22.2'
      - name: Enforce reviewed image and install exact Rust
        shell: bash
        run: |
          test -n "$EXPECTED_IMAGE_VERSION"
          test "$ImageVersion" = "$EXPECTED_IMAGE_VERSION"
          rustup toolchain install 1.95.0 --profile minimal --target wasm32-unknown-unknown
      - name: Sequential clean paired builds on this single runner
        working-directory: harness
        run: node contracts/payments/diagnostics/rebuild.mjs
      - name: Upload UNAPPROVED evidence even on failure
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: UNAPPROVED-g1-repro-${{ github.run_id }}
          path: UNAPPROVED-diagnostics/
          if-no-files-found: warn
          retention-days: 14
