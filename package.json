{
  "name": "taply",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=24.22.2 <25", "pnpm": "11.5.0" },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm build && pnpm -r --sort run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --sort run test",
    "verify:brand": "pnpm --filter @taply/web run verify:brand",
    "check": "pnpm verify:brand && pnpm typecheck && pnpm lint && pnpm test"
  }
}
