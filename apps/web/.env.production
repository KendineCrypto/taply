# Public build-time values for production builds (taplyapp.xyz). No secrets:
# every NEXT_PUBLIC_* value ships to the browser anyway.
# A value set in the hosting dashboard (Vercel) overrides this file, so
# NEXT_PUBLIC_TAPLY_FLAG_PROTECTED_PAY=off there is the kill switch.
#
# Protected Pay on NEAR Testnet (owner decision 2026-11-11): the escrow
# candidate contract, pinned by code hash. The account has no access keys, so
# its code cannot change. Not audited; test NEAR only.
NEXT_PUBLIC_TAPLY_FLAG_PROTECTED_PAY=on
NEXT_PUBLIC_TAPLY_PROTECTED_CONTRACT_ID=taply-e2e-ce38a238.testnet
NEXT_PUBLIC_TAPLY_PROTECTED_CODE_HASH=963iSEB8XFKeUMY1gmj5bCuA2JMVD55ksjdLfCwiPA84
NEXT_PUBLIC_TAPLY_PROTECTED_QA=on
