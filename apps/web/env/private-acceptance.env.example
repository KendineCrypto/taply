# retry_native_transfer, cancel_unfunded). Still requires a get_config check of the
# approved code hash at a fresh final block before every signature.
NEXT_PUBLIC_TAPLY_FLAG_INSTANT_PAY=on
NEXT_PUBLIC_TAPLY_FLAG_MERCHANT=off
NEXT_PUBLIC_TAPLY_FLAG_HANDSHAKE=off
NEXT_PUBLIC_TAPLY_FLAG_PROTECTED_PAY=off
# CHANGED: share links/QRs must open on the tailnet origin.
