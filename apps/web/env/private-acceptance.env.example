# Only for the owner's tailnet build (https://desktop-sdai72b.tailde1299.ts.net,
# Tailscale Serve, tailnet-only, no Funnel). Never on Vercel or taplyapp.xyz.
# Differences from MODE 1 are marked CHANGED. Everything else stays identical.
NEXT_PUBLIC_TAPLY_NETWORK=near-testnet
NEXT_PUBLIC_TAPLY_CONTRACT_ID=taply-pay-pilot-1.testnet
NEXT_PUBLIC_TAPLY_CONTRACT_CODE_HASH=BrR6bioUxuLzYD9m3TMSXmY9KYiLSrq3DSnQrfP6iZ9B
