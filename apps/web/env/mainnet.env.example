# MODE 3 — NEAR MAINNET (Vercel project `taply-mainnet`, host mainnet.taplyapp.xyz)
# Owner-confirmed values 2026-11-13 (docs/MAINNET_BRIEF.md §0). Real funds,
# unaudited contract, capped at 1 NEAR / 25 USDC per request by the contract.
#
# Set EVERY key below in the mainnet project's Vercel dashboard. The committed
# apps/web/.env.production holds TESTNET values and Next.js loads it into every
# production build; a dashboard value overrides it, a missing one does not.
# `node scripts/check-mainnet-env.mjs --require-mainnet` (the project's build
# command) refuses the build if any Testnet value survives.
#
# This file is the PRODUCTION scope. The staging Preview scope differs only in
# the lines marked PREVIEW (docs/MAINNET_INFRA.md §4.2).
# No secrets here: every NEXT_PUBLIC_* value ships to the browser.

NEXT_PUBLIC_TAPLY_NETWORK=near-mainnet

# RPC: explicit, because the runtime defaults are Testnet URLs.
NEXT_PUBLIC_TAPLY_RPC_URL=https://rpc.mainnet.fastnear.com
NEXT_PUBLIC_TAPLY_RPC_PROVIDER_ID=fastnear-mainnet
NEXT_PUBLIC_TAPLY_VERIFIER_RPC_URL=https://archival-rpc.mainnet.fastnear.com
NEXT_PUBLIC_TAPLY_VERIFIER_RPC_PROVIDER_ID=fastnear-archival-mainnet
# The verifier fallback's default is a TESTNET archival node: name a mainnet
# one or turn it off. Never leave it unset on mainnet.
NEXT_PUBLIC_TAPLY_VERIFIER_FALLBACK_RPC_URL=off
NEXT_PUBLIC_TAPLY_EXPLORER_BASE_URL=https://nearblocks.io

# The current reviewed Mainnet contract supports instant payments only;
# protectedPay:false. Code hash is filled only after separately approved
# deployment/initialization and on-chain verification. Access-key deletion is
# never an automatic deployment step and needs independent owner approval.
# PREVIEW: devkendinecrypto.near and the staging code hash.
NEXT_PUBLIC_TAPLY_CONTRACT_ID=taply-pay.kendinecrypto.near
NEXT_PUBLIC_TAPLY_CONTRACT_CODE_HASH=
NEXT_PUBLIC_TAPLY_PROTECTED_CONTRACT_ID=taply-pay.kendinecrypto.near
NEXT_PUBLIC_TAPLY_PROTECTED_CODE_HASH=

# PREVIEW: leave empty (each Preview uses its own origin).
NEXT_PUBLIC_TAPLY_SHARE_ORIGIN=https://mainnet.taplyapp.xyz

# Flags. Everything that signs starts OFF and is turned on per feature only
# after it has mainnet evidence under docs/evidence/ (brief §1).
NEXT_PUBLIC_TAPLY_FLAG_WALLET=on
NEXT_PUBLIC_TAPLY_FLAG_INSTANT_PAY=off
NEXT_PUBLIC_TAPLY_FLAG_PROTECTED_PAY=off
NEXT_PUBLIC_TAPLY_PROTECTED_QA=off
NEXT_PUBLIC_TAPLY_FLAG_MERCHANT=off
NEXT_PUBLIC_TAPLY_FLAG_HANDSHAKE=off
NEXT_PUBLIC_TAPLY_FLAG_CONTACTS=off
NEXT_PUBLIC_TAPLY_FLAG_SPLIT=off
NEXT_PUBLIC_TAPLY_FLAG_RECURRING=off

TAPLY_CSP_MODE=enforce

# Mainnet integration switches. NO-GO for funds: these stay as below on
# Production. A staging Preview may use NEXT_PUBLIC_TAPLY_MAINNET_FIXTURES=on
# and TAPLY_ONECLICK_MODE=fixture to exercise the screens without chain data.
NEXT_PUBLIC_TAPLY_MAINNET_FIXTURES=off
NEXT_PUBLIC_TAPLY_MAINNET_SIGNING=off
TAPLY_ONECLICK_MODE=off

# Mainnet Gift and Protected Pay escrow contracts: NOT approved or deployed.
# Leave unset. Production refuses them (scripts/check-mainnet-env.mjs). A staging
# Preview may point them at a reviewed candidate only after owner approval.
#   NEXT_PUBLIC_TAPLY_GIFT_CONTRACT_ID / _CODE_HASH / _MIN_YOCTO / _MAX_YOCTO / _FEE_YOCTO
#   NEXT_PUBLIC_TAPLY_MAINNET_ESCROW_CONTRACT_ID / _CODE_HASH

# SERVER ONLY (never NEXT_PUBLIC). Set in the dashboard, never in a file:
#   KV_REST_API_URL / KV_REST_API_TOKEN  — the mainnet project's OWN Upstash
#                                          database (not the Testnet one)
#   TAPLY_ONECLICK_API_KEY               — optional; only if the owner issues one
