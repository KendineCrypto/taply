# Taply v0.4 frontend — placeholders only. Never commit real values.
# Protocol Freeze v1 §1: NEAR Testnet exclusively; no mainnet fallback.

# Logical environment. The app refuses to run payment flows for any other value.
NEXT_PUBLIC_TAPLY_NETWORK=near-testnet

# Codex-owned API (taply.api.v1). Endpoints live under /api/v1.
NEXT_PUBLIC_TAPLY_API_BASE_URL=http://localhost:8787

# Testnet payments contract account id. Unset until Codex deploys and reports it.
# Never invent a value here.
NEXT_PUBLIC_TAPLY_CONTRACT_ID=

# Public Testnet JSON-RPC used by @taply/near-client for read-only balance reads.
# Must be HTTPS, CORS-enabled and carry no credentials: this value ships to the
# browser. Every read is checked against the pinned Testnet genesis hash.
NEXT_PUBLIC_TAPLY_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_TAPLY_RPC_PROVIDER_ID=near-public-testnet

# Explorer base used only to build evidence links.
NEXT_PUBLIC_TAPLY_EXPLORER_BASE_URL=https://testnet.nearblocks.io

# Optional capability flags. All default OFF; only a verified capability turns on.
# See src/lib/flags/features.ts for the authoritative defaults.
# Wallet connection + read-only balance is ON by default. Set to 'off' as a
# kill switch. It never enables signing a payment.
NEXT_PUBLIC_TAPLY_FLAG_WALLET=on
NEXT_PUBLIC_TAPLY_FLAG_PROTECTED_PAY=off
NEXT_PUBLIC_TAPLY_FLAG_HANDSHAKE=off
NEXT_PUBLIC_TAPLY_FLAG_MERCHANT=off
