# Taply v0.4 frontend — placeholders only. Never commit real values.
# Protocol Freeze v1 §1: NEAR Testnet exclusively; no mainnet fallback.

# Logical environment. The app refuses to run payment flows for any other value.
NEXT_PUBLIC_TAPLY_NETWORK=near-testnet

# Codex-owned API (taply.api.v1). Endpoints live under /api/v1.
NEXT_PUBLIC_TAPLY_API_BASE_URL=http://localhost:8787

# Testnet payments contract account id AND its human-approved base58 code hash.
# Both are required together; one without the other (or a malformed value)
# disables every payment read and transaction. Unset until a reviewed Testnet
# deployment exists. Never invent a value here.
NEXT_PUBLIC_TAPLY_CONTRACT_ID=
NEXT_PUBLIC_TAPLY_CONTRACT_CODE_HASH=

# Public Testnet JSON-RPC used by @taply/near-client for read-only balance reads.
# Must be HTTPS, CORS-enabled and carry no credentials: this value ships to the
# browser. Every read is checked against the pinned Testnet genesis hash.
NEXT_PUBLIC_TAPLY_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_TAPLY_RPC_PROVIDER_ID=near-public-testnet

# Optional separate RPC for the read-only receipt verifier and funding locator
# (old receipts need an archival node). Set BOTH or neither; a half-set or
# non-HTTPS value disables chain reads. Leave empty to use the RPC above.
# Note: archival-rpc.testnet.near.org rate-limits per IP and its 429 answers
# carry no CORS headers, so browsers see them as network errors.
NEXT_PUBLIC_TAPLY_VERIFIER_RPC_URL=
NEXT_PUBLIC_TAPLY_VERIFIER_RPC_PROVIDER_ID=

# Explorer base used only to build evidence links.
NEXT_PUBLIC_TAPLY_EXPLORER_BASE_URL=https://testnet.nearblocks.io

# Optional public HTTPS origin used for share links and payment QR codes, for a
# local pilot served through an HTTPS tunnel (e.g. https://your-host.example-tunnel.net).
# Origin only: no path. HTTP, localhost, IP addresses and private names are
# rejected. Leave empty in production: the site's own HTTPS origin is used.
# Without a valid origin the app shows no payment QR and says why.
NEXT_PUBLIC_TAPLY_SHARE_ORIGIN=

# Optional capability flags. All default OFF; only a verified capability turns on.
# See src/lib/flags/features.ts for the authoritative defaults.
# Wallet connection + read-only balance is ON by default. Set to 'off' as a
# kill switch. It never enables signing a payment.
NEXT_PUBLIC_TAPLY_FLAG_WALLET=on
# Instant Pay SIGNING gate. Off until a human approves it after Testnet review.
# Even when on, signing also requires the contract above to pass a get_config
# check at a finalized block (no fault build, no unreviewed capability).
NEXT_PUBLIC_TAPLY_FLAG_INSTANT_PAY=off
NEXT_PUBLIC_TAPLY_FLAG_PROTECTED_PAY=off
# Protected Pay G3 candidate (contracts/payments-protected). Leave empty: never
# the G1 pilot, never production until reviewed and proven on Testnet.
NEXT_PUBLIC_TAPLY_PROTECTED_CONTRACT_ID=
NEXT_PUBLIC_TAPLY_PROTECTED_CODE_HASH=
NEXT_PUBLIC_TAPLY_PROTECTED_QA=off
NEXT_PUBLIC_TAPLY_FLAG_HANDSHAKE=off
NEXT_PUBLIC_TAPLY_FLAG_MERCHANT=off
